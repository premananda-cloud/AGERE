name: rl_env
channels:
  - conda-forge
dependencies:
  - python=3.10
  - pip

  # setuptools>=82 removed the pkg_resources module entirely. gym-pybullet-
  # drones still imports it internally (BaseAviary.py), so anything >=82
  # crashes with `ModuleNotFoundError: No module named 'pkg_resources'`.
  # Pinned here so a fresh `conda env create` doesn't hit this — remove the
  # pin once gym-pybullet-drones drops its pkg_resources dependency upstream.
  - setuptools<82

  - numpy
  - scipy
  - matplotlib
  - pyyaml
  - tqdm
  - tensorboard
  - pip:
      # --- PyTorch (CUDA 12.6 wheels; compatible with driver 595.x / CUDA 13.2) ---
      - --extra-index-url https://download.pytorch.org/whl/cu126
      - torch
      - torchvision
      - torchaudio

      # --- RL stack ---
      - gymnasium
      - stable-baselines3[extra]

      # --- Simulation (PyBullet only — no PX4/MAVSDK in this repo; that
      #     lives in AGERE_sims). Compiles pybullet from source on install —
      #     needs a C compiler (`sudo apt install build-essential` on
      #     Ubuntu/Debian first if the wheel build fails). ---
      - git+https://github.com/learnsyslab/gym-pybullet-drones.git

      # --- Hugging Face (upload trained model) ---
      - huggingface_hub
      - safetensors

      # --- Optional: only if you're also logging experiments ---
      - wandb
